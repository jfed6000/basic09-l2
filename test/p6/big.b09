PROCEDURE bigmain
DIM x:REAL
x:=0.
RUN big01(x)
RUN big02(x)
RUN big03(x)
RUN big04(x)
RUN big05(x)
RUN big06(x)
RUN big07(x)
RUN big08(x)
RUN big09(x)
RUN big10(x)
RUN big11(x)
RUN big12(x)
RUN big13(x)
RUN big14(x)
RUN big15(x)
RUN big16(x)
RUN big17(x)
RUN big18(x)
RUN big19(x)
RUN big20(x)
RUN big21(x)
RUN big22(x)
RUN big23(x)
RUN big24(x)
RUN big25(x)
RUN big26(x)
RUN big27(x)
RUN big28(x)
RUN big29(x)
RUN big30(x)
PRINT "big: total "; x
END

