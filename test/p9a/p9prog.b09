PROCEDURE p9mainDIM i:INTEGERDIM r:REALPRINT "p9: start"FOR i=1 TO 3RUN p9sub(i,"x")NEXT iON ERROR GOTO 100r=LOG(-1)100 PRINT "p9: trapped "; ERRPRINT "p9: done"ENDPROCEDURE p9subPARAM n:INTEGER; t:STRINGPRINT "p9: sub "; n; tENDPROCEDURE p9argPARAM a:STRING; n:INTEGERPRINT "p9: arg "; a; nENDPROCEDURE p9strPARAM a,b:STRINGPRINT "p9: str "; a; " "; bENDPROCEDURE p9badDIM a(3):INTEGERPRINT "p9: bad"a(5)=1END