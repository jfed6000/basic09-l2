PROCEDURE p4main
DIM fm(4):INTEGER
DIM rec(64):REAL
DIM i,n,bad:INTEGER
RUN farmem("alloc",fm,256)
PRINT "p4: allocated blocks"; fm(2)
n:=800
FOR i:=1 TO n
rec(1):=i
rec(32):=i*2
rec(64):=-i
RUN farmem("put",fm,i-1,rec)
NEXT i
bad:=0
FOR i:=n TO 1 STEP -1
RUN farmem("get",fm,i-1,rec)
IF rec(1)<>i OR rec(32)<>i*2 OR rec(64)<>-i THEN
bad:=bad+1
ENDIF
NEXT i
PRINT "p4: records"; n; " bad"; bad
ON ERROR GOTO 100
RUN farmem("get",fm,n+100,rec)
PRINT "p4: no range error"
100 PRINT "p4: range error"; ERR
ON ERROR
RUN farmem("free",fm)
PRINT "p4: freed"
END

PROCEDURE p4bench
DIM fm(4):INTEGER
DIM a(10):INTEGER
DIM v,i,k:INTEGER
RUN farmem("alloc",fm,64)
k:=0
PRINT "bench start "; DATE$
FOR i:=1 TO 5000
k:=4096-k
v:=a(5)
NEXT i
PRINT "bench 5000 local "; DATE$
FOR i:=1 TO 5000
k:=4096-k
RUN farmem("get",fm,5,v)
NEXT i
PRINT "bench 5000 far same block "; DATE$
FOR i:=1 TO 5000
k:=4096-k
RUN farmem("get",fm,k,v)
NEXT i
PRINT "bench 5000 far alternating blocks "; DATE$
RUN farmem("free",fm)
END
