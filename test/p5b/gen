#!/usr/bin/env python3
"""P5.2a test data: File commands through keys, menus and dialogs.

usage: gen <outdir>
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
from keys import compile_keys  # noqa: E402

out = sys.argv[1]
keys = '''
"hello" enter ^s "one.b09" enter        # no name yet: Save asks for one
^o "two.b09" enter "X" alt-f "s"        # open another file; File menu, Save by letter
alt-f "n"                               # New (nothing to save)
alt-o enter                             # Options: auto indent off
"  ind" enter "x"
^q esc                                  # quit asks; Esc cancels
alt-f down down down enter              # File menu by arrows: Save as
"three.b09" enter
"!" ^q "y"                              # quit, saving the change
'''
files = {
    'two.b09': 'second\r',
    'one.exp': 'hello\r',
    'two.exp': 'Xsecond\r',
    'three.exp': '  ind\rx!',
}
for name, text in files.items():
    with open(os.path.join(out, name), 'w', newline='') as f:
        f.write(text)
with open(os.path.join(out, 'keys.bin'), 'wb') as f:
    f.write(compile_keys(keys))
