#!/usr/bin/env python3
"""Global TYPE lines: DEFTYPE <name> ... END DEFTYPE blocks hold TYPE
lines; they are not procedures and are never sent.  A procedure's
"USE <name>" line goes to l2b09run as the block's TYPE lines, joined
with backslashes into one line and without their comments, then
"(* " and the line.  A change to the block alone sends the procedures
that use it again: main prints the size of its record, 10 and then 15.
Run starts main, not the block before it.  Pretty print keeps the USE
lines (indented like the body) and leaves the blocks alone, also the
one between two procedures.

usage: gen <outdir>
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
from keys import compile_keys  # noqa: E402

out = sys.argv[1]
prog = '''DEFTYPE shapes
TYPE pt=x,y:REAL (* a point *)
END DEFTYPE
PROCEDURE main
USE shapes
DIM p:pt
p.x=1.5
p.y=2
PRINT "size="; SIZE(p)
RUN show(p)
END
DEFTYPE unused
  TYPE nothing=n:INTEGER
END DEFTYPE
PROCEDURE show
   use shapes
PARAM q:pt
PRINT "x="; q.x; " y="; q.y
END
'''
keys = '''
^b                          # Make: main and show, not the blocks
^r                          # Run main: size=10
^g "2" enter right*10 "z,"  # the block only: TYPE pt=x,z,y:REAL
^b                          # Make: main and show again
^r                          # Run: size=15
^space                      # pretty print every procedure
^b                          # up to date: nothing is sent
^s ^q
'''
# Make sends the TYPE text with main and show; LIST shows the joined
# lines
log = r'''# -t=/dd/l2b09/term.out
< l2basic09 runtime; Basic09 copyright 1980 Motorola and Microware

< l2b09run
< %READY
> load basic09-l2.tmp
< main
< show
< %READY
> run main
< %READY
> load basic09-l2.tmp
< main
< show
< %READY
> run main
< %READY
> list main
< PROCEDURE main
<  0000      TYPE pt=x,z,y:REAL \(* USE shapes
<  0020      DIM p:pt
<  0029      p.x=1.5
<  0038      p.y=2
<  0044      PRINT "size="; SIZE(p)
<  0053      RUN show(p)
<  005D      END 
< %READY
> list show
< PROCEDURE show
<  0000      TYPE pt=x,z,y:REAL \(* use shapes
<  0020      PARAM q:pt
<  0029      PRINT "x="; q.x; " y="; q.y
<  0043      END 
< %READY
> bye
'''
# pretty print keeps the USE lines and the blocks
expect = r'''DEFTYPE shapes
TYPE pt=x,z,y:REAL (* a point *)
END DEFTYPE
procedure main
  USE shapes
  dim p:pt
  p.x=1.5
  p.y=2
  print "size="; size(p)
  run show(p)
end
DEFTYPE unused
  TYPE nothing=n:INTEGER
END DEFTYPE
procedure show
  use shapes
  param q:pt
  print "x="; q.x; " y="; q.y
end
'''
with open(os.path.join(out, 'prog.b09'), 'w', newline='') as f:
    f.write(prog.replace('\n', '\r'))
with open(os.path.join(out, 'log.exp'), 'w', newline='') as f:
    f.write(log)
with open(os.path.join(out, 'prog.exp'), 'w', newline='') as f:
    f.write(expect.replace('\n', '\r'))
with open(os.path.join(out, 'keys.bin'), 'wb') as f:
    f.write(compile_keys(keys))
