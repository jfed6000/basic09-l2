#!/usr/bin/env python3
"""Shared declarations: DEFUSE <name> ... END DEFUSE blocks hold TYPE and
PARAM lines; they are not procedures and are never sent.  A procedure's
"USE <name>" line goes to l2b09run as the block's TYPE and PARAM lines
(any other line, such as a DIM, is left out), joined
with backslashes into one line and without their comments, then
"(* " and the line.  A change to the block alone sends the procedures
that use it again: main prints the size of its record, 10 and then 15.
Run starts main, not the block before it.  Pretty print keeps the USE
lines (indented like the body) and the blocks, also the one between
two procedures, changing only the case of their keywords: "use" and
the lower-case block "unused" come out in capitals (since 2026-10-25).
show takes its PARAM from a second block, with a second USE line
(until 2026-10-24 the blocks were DEFTYPE, and held only TYPE lines).

usage: gen <outdir>
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
from keys import compile_keys  # noqa: E402

out = sys.argv[1]
prog = '''DEFUSE shapes
TYPE pt=x,y:REAL (* a point *)
END DEFUSE
PROCEDURE main
USE shapes
DIM p:pt
p.x=1.5
p.y=2
PRINT "size="; SIZE(p)
RUN show(p)
END
defuse unused
  type nothing=n:INTEGER
end defuse
DEFUSE sparm
PARAM q:pt (* the point *)
DIM z:INTEGER
END DEFUSE
PROCEDURE show
   use shapes
USE sparm
PRINT "x="; q.x; " y="; q.y
END
'''
keys = '''
^b                          # Make: main and show, not the blocks
^r                          # Run main: size=10
^g "2" enter right*10 "z,"  # the block only: TYPE pt=x,z,y:REAL
^b                          # Make: main and show again
^r                          # Run: size=15
f2                          # pretty print every procedure
^b                          # up to date: nothing is sent
^s ^q
'''
# Make sends the TYPE text with main and show; LIST shows the joined
# lines
log = r'''# -t=/dd/l2b09/term.out
< l2basic09 runtime; Basic09 copyright 1980 Motorola and Microware

< l2b09run
< %READY
> load basic09-l2.tmp
< main
< show
< %READY
> run main
< %READY
> load basic09-l2.tmp
< main
< show
< %READY
> run main
< %READY
> list main
< PROCEDURE main
<  0000      TYPE pt=x,z,y:REAL \(* USE shapes
<  0020      DIM p:pt
<  0029      p.x=1.5
<  0038      p.y=2
<  0044      PRINT "size="; SIZE(p)
<  0053      RUN show(p)
<  005D      END 
< %READY
> list show
< PROCEDURE show
<  0000      TYPE pt=x,z,y:REAL \(* use shapes
<  0020      PARAM q:pt \(* USE sparm
<  0035      PRINT "x="; q.x; " y="; q.y
<  004F      END 
< %READY
> bye
'''
# pretty print keeps the USE lines and the blocks, with their keywords in
# capitals (the default)
expect = r'''DEFUSE shapes
TYPE pt=x,z,y:REAL (* a point *)
END DEFUSE
PROCEDURE main
  USE shapes
  DIM p:pt
  p.x=1.5
  p.y=2
  PRINT "size="; SIZE(p)
  RUN show(p)
END
DEFUSE unused
  TYPE nothing=n:INTEGER
END DEFUSE
DEFUSE sparm
PARAM q:pt (* the point *)
DIM z:INTEGER
END DEFUSE
PROCEDURE show
  USE shapes
  USE sparm
  PRINT "x="; q.x; " y="; q.y
END
'''
with open(os.path.join(out, 'prog.b09'), 'w', newline='') as f:
    f.write(prog.replace('\n', '\r'))
with open(os.path.join(out, 'log.exp'), 'w', newline='') as f:
    f.write(log)
with open(os.path.join(out, 'prog.exp'), 'w', newline='') as f:
    f.write(expect.replace('\n', '\r'))
with open(os.path.join(out, 'keys.bin'), 'wb') as f:
    f.write(compile_keys(keys))
