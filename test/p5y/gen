#!/usr/bin/env python3
"""Shift+RUN/STOP runs the program, as ^R; plain RUN/STOP (Esc) does not.
usage: gen <outdir>
"""
import os
import sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
from keys import compile_keys  # noqa: E402
out = sys.argv[1]
prog = '''PROCEDURE sr
PRINT "shift run"
END
'''
keys = '''
esc                         # RUN/STOP alone: cancels, nothing runs
srun                        # Shift+RUN/STOP: Make and Run
^q
'''
with open(os.path.join(out, 'sr.b09'), 'w', newline='') as f:
    f.write(prog.replace('\n', '\r'))
with open(os.path.join(out, 'keys.bin'), 'wb') as f:
    f.write(compile_keys(keys))
