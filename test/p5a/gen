#!/usr/bin/env python3
"""P5.1 test data: a large source file, a key script that edits it, and
the file the edits must produce (from tools/edmodel.py).

usage: gen <outdir>
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
from edmodel import Session, source, write  # noqa: E402


def main():
    outdir = sys.argv[1]
    text = source(3000)
    s = Session(text)

    s.goto(1000)                                 # insert a line
    s.type('REM inserted A')
    s.key('enter')
    s.goto(2500)                                 # delete three lines
    s.key('^d', 3)
    s.goto(50)                                   # 40 new lines: page splits
    for i in range(40):
        s.type('REM split %02d ' % i + 'abcdefghij' * 5)
        s.key('enter')
    s.goto(2000)                                 # delete 200 lines: joins
    s.key('^d', 200)
    s.goto(700)                                  # join two lines
    s.key('bs')
    s.goto(800)                                  # edit inside a line
    s.key('right', 5)
    s.type('XYZ')
    s.key('^k')
    s.type('!')
    s.goto(900)
    s.key('del', 3)
    s.goto(1200)                                 # vertical moves keep the column
    s.key('right', 4)
    s.key('down', 3)
    s.key('up')
    s.type('#')
    s.key('wright', 2)                           # words
    s.type('_')
    s.key('wleft')
    s.type('<')
    s.goto(1500)                                 # auto-indent
    s.key('^k')
    s.key('enter')
    s.type('REM indented')
    s.key('^j')
    s.type('>')
    s.key('bottom')                              # end of the text
    s.type('last')
    s.key('top')                                 # first line
    s.key('^d')
    s.raw('pgdn*20')                             # page moves (no text change)
    s.raw('^s ^q')

    write(outdir, 'big.b09', text)
    write(outdir, 'big.exp', s.m.t)
    write(outdir, 'keys.bin', s.keybytes())


main()
