PROCEDURE p1main
DIM i:INTEGER
DIM r:REAL
PRINT "l2b09 P1: main start"
FOR i:=1 TO 10
RUN p1fib(i,r)
PRINT "fib("; i; ")="; r
NEXT i
RUN sieve
PRINT "l2b09 P1: main done"
END

PROCEDURE p1fib
PARAM n:INTEGER; r:REAL
DIM a,b,t:REAL
DIM k:INTEGER
a:=0.
b:=1.
FOR k:=1 TO n
t:=a+b
a:=b
b:=t
NEXT k
r:=a
END

PROCEDURE sieve
DIM flags(8191):BOOLEAN; i,k,prime,count:INTEGER
BASE 0
count:=0
FOR i:=0 TO 8190 \flags(i):=TRUE \NEXT i
FOR i:=0 TO 8190
IF flags(i) THEN
prime:=i+i+3
FOR k:=i+prime TO 8190 STEP prime \flags(k):=FALSE \NEXT k
count:=count+1
ENDIF
NEXT i
PRINT count; " primes"
END
