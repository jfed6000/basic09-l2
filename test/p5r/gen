#!/usr/bin/env python3
"""The help browser.  On its own, with the screen going to a file:
"le" is no page, so the names starting with it are listed, and Enter
opens the first (LEFT$); "print", Right, Enter follows the second link
on the PRINT page (PRINT USING) and Backspace comes back; a word with no
page and no name starting with it opens the contents.  Then from the
editor (its screen to a file): F1 with the cursor in LEFT$ (its $
included) opens that page, Esc goes back to the editor, and ^Q quits
it.  Last, the same with -h: the snapshot shows the editor drawn again
after the help.

usage: gen <outdir>
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
from keys import compile_keys  # noqa: E402

out = sys.argv[1]
with open(os.path.join(out, 'hp.b09'), 'w', newline='') as f:
    f.write('PROCEDURE hp\rPRINT LEFT$("ab",1)\rEND\r')
for name, keys in (('keys1.bin', 'enter esc'),
                   ('keys2.bin', 'right enter bs esc'),
                   ('keys3.bin', 'esc'),
                   ('keys4.bin', 'down right*8 f1 esc ^q'),
                   ('keys.bin', 'down right*8 f1 esc')):
    with open(os.path.join(out, name), 'wb') as f:
        f.write(compile_keys(keys))
