#!/usr/bin/env python3
"""P5.6 test data: pretty print (Compile > Pretty print, All: pretty print).

usage: gen <outdir>
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
from keys import compile_keys  # noqa: E402

out = sys.argv[1]
main = '''PROCEDURE ppmain
dim i,k:integer
10 k=0
for i=1 to 3
if i=2 then
k=k+10
else
k=k+i
endif
next i
print "k=";k;"and a long line with many items to wrap";i;k;i;k;i;k;"tail"
if k>99 then
end
endif
run ppsub(k)
end
'''
sub = '''procedure ppsub
param n:integer
print "n=";n
end
'''
pmain = '''PROCEDURE ppmain
  DIM i,k:INTEGER
10 k=0
  FOR i=1 TO 3
    IF i=2 THEN
      k=k+10
    ELSE
      k=k+i
    ENDIF
  NEXT i
  PRINT "k="; k; "and a long line with many items to wrap"; i; k; i; k; i; k; "tail"
  IF k>99 THEN
    END
  ENDIF
  RUN ppsub(k)
END
'''
psub = '''PROCEDURE ppsub
  PARAM n:INTEGER
  PRINT "n="; n
END
'''
files = {'pp.b09': main + sub, 'pp1.exp': pmain + sub, 'pp3.exp': main + sub,
         'pp4.exp': pmain + psub}
for name, text in files.items():
    with open(os.path.join(out, name), 'w', newline='') as f:
        f.write(text.replace('\n', '\r'))
saveas = 'alt-f down down down enter'
keys = '''
^g "6" enter ^t             # a breakpoint on k=k+10, the cursor there too
right right                 # (column 3)
alt-c "p"                   # pretty print ppmain (Make loads both first)
%(sa)s "pp1.b09" enter
alt-c "p"                   # again: the same text
%(sa)s "pp2.b09" enter
^z                          # one undo: the original
%(sa)s "pp3.b09" enter
^y                          # redo
^r                          # Make sends nothing; the breakpoint stops it
^r                          # to the end
alt-c "a"                   # every procedure
%(sa)s "pp4.b09" enter
^g "16" enter ^k " " ^b     # ppmain changed (a space): Make compiles the pretty text
^q "n"
''' % {'sa': saveas}
with open(os.path.join(out, 'keys.bin'), 'wb') as f:
    f.write(compile_keys(keys))
