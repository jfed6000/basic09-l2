< l2basic09 runtime; Basic09 copyright 1980 Motorola and Microware

< l2b09run
< %READY
> load l2b09ed.tmp
< ppmain
< ppsub
< %READY
> list ppmain
< PROCEDURE ppmain
<  0000      DIM i,k:INTEGER
<  000B 10   k=0
<  0015      FOR i=1 TO 3
<  0025        IF i=2 THEN 
<  0031          k=k+10
<  003C        ELSE 
<  0040          k=k+i
<  004C        ENDIF 
<  004E      NEXT i
<  0059      PRINT "k="; k; "and a long line with many items to wrap"; i
            ; k; i; k; i; k; "tail"
<  00AC      IF k>99 THEN 
<  00B8        END 
<  00BA      ENDIF 
<  00BC      RUN ppsub(k)
<  00C6      END 
< %READY
> list ppmain
