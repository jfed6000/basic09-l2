< l2b09run
< %READY
> load l2b09ed.tmp
< ppmain
< ppsub
< %READY
> list ppmain
< PROCEDURE ppmain
<  0000      DIM i,k:INTEGER
<  000B      k=0
<  0012      FOR i=1 TO 3
<  0022        IF i=2 THEN 
<  002E          k=k+10
<  0039        ELSE 
<  003D          k=k+i
<  0049        ENDIF 
<  004B      NEXT i
<  0056      PRINT "k="; k; "and a long line with many items to wrap"; i
            ; k; i; k; i; k; "tail"
<  00A9      RUN ppsub(k)
<  00B3      END 
< %READY
> list ppmain
< PROCEDURE ppmain
<  0000      DIM i,k:INTEGER
