* l2basic09: an old program on the new system.  A PACKed module, not
* compiled in this session, run from the command level with arguments
* (l2b09run's compiler, l2b09cc, has never seen it).
-x
chd /dd/l2b09
/dd/l2b09/l2b09run #16k <pk.cmds >pk.out >>pk.err
load /dd/l2b09/p8dpk
echo >term.out
/dd/l2b09/l2b09run #16k -t=/dd/l2b09/term.out <r.cmds >r.out >>r.err
unlink p8main p8args
* %INPUT: sent as INPUT reads the program's terminal (here an empty
* file, so the read then ends with error 211), so a stepping editor can
* show the program's screen
echo >tin.txt
/dd/l2b09/l2b09run -t=/dd/l2b09/tin.txt <i.cmds >i.out >>i.err
* statements on one line: %DEBUG <proc> <line> <n> for the n+1th
echo >ts.txt
/dd/l2b09/l2b09run -t=/dd/l2b09/ts.txt <s.cmds >s.out >>s.err
* the compiler against stock Basic09: the image's own basic09 and
* l2b09cc PACK startrek into byte-identical modules
/dd/cmds/basic09 #32k <pb.cmds >pb.out >>pb.err
/dd/cmds/l2b09cc #32k <pc.cmds >pc.out >>pc.err
