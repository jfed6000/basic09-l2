#!/usr/bin/env python3
"""Each Run clears the program's terminal first, and when the program
ends the editor waits for a key there under "Press any key" (Options >
Pause after run, on by default).  The program prints "it"; after two
Runs (Esc answers each pause), F5 shows that terminal (and -h keeps
it): "it" once on the top row, the prompt under it.

usage: gen <outdir>
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
from keys import compile_keys  # noqa: E402

out = sys.argv[1]
with open(os.path.join(out, 'cl.b09'), 'w', newline='') as f:
    f.write('PROCEDURE cl\rPRINT "it"\rEND\r')
with open(os.path.join(out, 'keys.bin'), 'wb') as f:
    f.write(compile_keys('^r esc ^r esc f5'))
