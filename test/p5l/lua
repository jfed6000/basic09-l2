-- P5.7: drive the editor's keyboard and mouse on /term.  The pointer
-- moves by PS/2 deltas (MAME clamps each frame's to 255), so it is sent
-- home to 0,0 before each click and then moved out to the cell in
-- steps.  The axis values stay positive (MAME clamps them at 0).  Cells
-- are 8x16 pixels.
local ports = manager.machine.ioport.ports
local function field(tag)
    for _, f in pairs(ports[tag].fields) do return f end
end
local fx, fy = field(":MOUSEX"), field(":MOUSEY")
local fb = ports[":MOUSE_BUTTONS"].fields["Left Button"]
local steps = {}
local cx, cy = 30000, 30000
local function add(f) steps[#steps + 1] = f end
local function wait(n) for _ = 1, n do add(function() end) end end
local function moveto(px, py)   -- 100 pixels a step
    while cx ~= px or cy ~= py do
        cx = cx + math.max(-100, math.min(100, px - cx))
        cy = cy + math.max(-100, math.min(100, py - cy))
        local nx, ny = cx, cy
        add(function() fx:set_value(nx); fy:set_value(ny) end); wait(2)
    end
end
local function over(c, r)      -- home, then out to the middle of the cell
    local hx, hy = cx - 1000, cy - 1000
    moveto(hx, hy)
    moveto(hx + c * 8 + 4, hy + r * 16 + 8)
    wait(10)
end
local function button(v) add(function() fb:set_value(v) end); wait(10) end
local function click(c, r) over(c, r); button(1); button(0); wait(10) end
local function keys(s) add(function() manager.machine.natkeyboard:post(s) end); wait(60) end

wait(60 * 50)                   -- the editor is up by then
add(function() fx:set_value(cx); fy:set_value(cy) end); wait(5)
click(5, 3) keys("0")           -- a=1 becomes a=10
click(0, 4)                     -- the left border of b=2: a breakpoint
click(6, 6) keys("5")           -- d=4 becomes d=45
over(23, 0) button(1)           -- press on Run, drag down to its Run item,
moveto(cx, cy + 32) wait(10)    -- release there: Make, run, it stops at b=2
button(0)
local i = 0
p5l_sub = emu.add_machine_frame_notifier(function()   -- global: kept alive
    i = i + 1
    if steps[i] then steps[i]() end
    if i == #steps then print("p5l: input done at frame " .. i) end
end)
