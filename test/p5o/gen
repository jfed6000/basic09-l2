#!/usr/bin/env python3
"""P5.7 test data: double spacing (Ctrl+2), from a key script, so the
frame and scroll bar are ASCII.  With it the editor lays out 15 rows on
the 80x30 screen and draws row r on screen row 2r: the menu bar on 0,
the top border on 2, the text from 4, the bottom border on 26 and the
hint line on 28.  The gap rows carry the side borders and the scroll
bar's track.  A dialog opened and closed must leave its gap rows
clean, and a press on logical row 5 (screen row 10) is on line 4.

usage: gen <outdir>
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools'))
from keys import compile_keys  # noqa: E402

out = sys.argv[1]
text = 'PROCEDURE ds\n' + ''.join('a%d=%d\n' % (n, n) for n in range(1, 40)) + 'END\n'
keys = '''
ps2^1 ^2                      # single (already), double
^g esc                        # a dialog over the gap rows, closed
click:3,5 "X"                 # logical row 5: window row 3, line 4
'''
with open(os.path.join(out, 'ds.b09'), 'w', newline='') as f:
    f.write(text.replace('\n', '\r'))
with open(os.path.join(out, 'keys.bin'), 'wb') as f:
    f.write(compile_keys(keys))
