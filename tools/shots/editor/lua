-- Screenshots for the video slides (tools/shots/shots.sh): the editor
-- with the Run menu open, then the debugger stopped at a breakpoint with
-- two watches. Each shot goes to MAME's snapshot directory as
-- l2b09shot-<name>.png.
local ports = manager.machine.ioport.ports
local function key(name)
    for _, p in pairs(ports) do if p.fields[name] then return p.fields[name] end end
end
local function field(tag) for _, f in pairs(ports[tag].fields) do return f end end
local fx, fy = field(":MOUSEX"), field(":MOUSEY")
local fb = ports[":MOUSE_BUTTONS"].fields["Left Button"]
local ctrl, esc, ret = key("Ctrl"), key("Escape"), key("Return")
local kt, kw, kr = key("t  T"), key("w  W"), key("r  R")
local scr = manager.machine.screens[":screen"]
local steps = {}
local cx, cy = 30000, 30000
local function add(f) steps[#steps + 1] = f end
local function wait(n) for _ = 1, n do add(function() end) end end
local function hold(f, v) add(function() f:set_value(v) end); wait(6) end
local function tap(f) hold(f, 1); hold(f, 0) end
local function ctl(f) hold(ctrl, 1); tap(f); hold(ctrl, 0) end
local function moveto(px, py)
    while cx ~= px or cy ~= py do
        cx = cx + math.max(-100, math.min(100, px - cx))
        cy = cy + math.max(-100, math.min(100, py - cy))
        local nx, ny = cx, cy
        add(function() fx:set_value(nx); fy:set_value(ny) end); wait(2)
    end
end
local function over(c, r)
    local hx, hy = cx - 1000, cy - 1000
    moveto(hx, hy)
    moveto(hx + c * 8 + 4, hy + r * 16 + 8)
    wait(10)
end
local function button(v) add(function() fb:set_value(v) end); wait(10) end
local function click(c, r) over(c, r); button(1); button(0); wait(10) end
local function shot(name) add(function() scr:snapshot("l2b09shot-" .. name .. ".png"); print("shot: " .. name) end) end

wait(60 * 50)                   -- the editor is up by then
add(function() fx:set_value(cx); fy:set_value(cy) end); wait(5)
shot("plain")
click(23, 0)                    -- the Run menu
wait(60)
shot("runmenu")
tap(esc); wait(30)
-- line n is screen row n+1, text column c is screen column c+1
click(4, 19)                    -- on "count" in line 18
ctl(kt); wait(30)               -- breakpoint
ctl(kw); wait(60)               -- watch: the word at the cursor
tap(ret); wait(30)
click(3, 14)                    -- on "s" in line 13
ctl(kw); wait(60)
tap(ret); wait(30)
ctl(kr)                         -- run: Make, then stop at the breakpoint
wait(60 * 40)
ctl(kr); wait(60 * 12)          -- continue twice: the third pass
ctl(kr); wait(60 * 12)
over(60, 25)                    -- the pointer out of the way
wait(30)
shot("debug")
local i = 0
l2b09shot_sub = emu.add_machine_frame_notifier(function()
    i = i + 1
    if steps[i] then steps[i]() end
    if i == #steps then print("shots: input done at frame " .. i) end
end)
